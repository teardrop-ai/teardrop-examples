# Copy to .env (git-ignored) and fill in. Use a dedicated wallet funded with about $1 of USDC on Base.

# Server. Anonymous x402 payers must use /tools/mcp on this host, never /mcp/v1 (JWT only).
TEARDROP_BASE_URL=https://api.teardrop.dev
# eip155:8453 (Base mainnet, default) or eip155:84532 (Base Sepolia, for a staging server)
TEARDROP_NETWORK=eip155:8453

# Payer key: prefer a file path (0x-prefixed 64-hex key, mode 0600). Never commit either.
PAYER_KEY_FILE=
PAYER_PRIVATE_KEY=

# Spend caps in atomic USDC units (1000000 = $1). Integers only.
MAX_PER_CALL_USDC=10000
MAX_TOTAL_USDC=100000
# Bridge only: rolling 24h cap kept in ~/.teardrop/bridge-ledger.jsonl, and an optional
# threshold above which the bridge asks the user to raise the cap instead of paying.
MAX_DAILY_USDC=100000
CONFIRM_ABOVE_USDC=

# Extra trusted payees (comma-separated). Required when a non-Teardrop server's payee changes.
TRUSTED_PAY_TO=
# upto (Permit2) is opt-in and needs a one-time USDC approval for Permit2 that you send yourself.
ALLOW_UPTO=0

# Where first-seen payees, the bridge ledger and bootstrap credentials are stored (default ~/.teardrop).
TEARDROP_STATE_DIR=
# Overrides the X-Teardrop-Client tag; must be one of the allowlisted values (the canary uses ex-canary).
TEARDROP_CLIENT_TAG=
